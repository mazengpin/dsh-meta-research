{
  "name": "dsh-meta-research",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "description": "The research half of the meta layer for the dsh-meta-evolve program. It computes a DRIFT census against four live sources (the decision log, the intent field, the profile manifest and the intent map) with a numerator and a denominator per check, and records the run to research/meta-research-last.json. It reads over loopback HTTP only; it opens no device and talks to no model.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "ROADMAP.md",
    "DISCLOSURE.md",
    "CONTEXT.md",
    "verify",
    "research.md"
  ],
  "engines": {
    "node": ">=22.18.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "verify": "node verify/host-half.ts && node verify/observer-render.mjs",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "tag": "next"
  },
  "status": "pre-release",
  "repository": {
    "type": "git",
    "url": "https://github.com/mazengpin/dsh-meta-research.git"
  },
  "homepage": "https://github.com/mazengpin/dsh-meta-research#readme"
}
